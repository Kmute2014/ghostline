generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id                   String                    @id @default(cuid())
  publicId             String                    @unique
  displayName          String
  inviteCode           String                    @unique
  recoveryCode         String                    @unique
  avatarFileId         String?
  nearbyVisible        Boolean                   @default(false)
  showInPeople         Boolean                   @default(true)
  notifyWhenPeopleOnline Boolean                   @default(true)
  onlineNotificationAudience String                @default("anyone")
  defaultStoryAudience String                    @default("public")
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  reportsAgainst       AbuseReport[]             @relation("Reported")
  reportsFiled         AbuseReport[]             @relation("Reporter")
  blocksReceived       BlockedUser[]             @relation("Blocked")
  blocksMade           BlockedUser[]             @relation("Blocker")
  contactsSaved        Contact[]                 @relation("ContactTarget")
  contactsOwned        Contact[]                 @relation("ContactOwner")
  conversations        ConversationParticipant[]
  files                File[]
  location             Location?
  messages             Message[]
  hiddenMessages       MessageHidden[]
  posts                Post[]
  postComments         PostComment[]
  postVotes            PostVote[]
  presence             Presence?
  pushSubscriptions    PushSubscription[]
  sessions             Session[]
  stories              Story[]
  storyViews           StoryView[]
}

model Session {
  id          String   @id @default(cuid())
  token       String   @unique
  socketToken String   @unique
  userId      String
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  expiresAt   DateTime
  user        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Presence {
  userId          String   @id
  isOnline        Boolean  @default(false)
  lastHeartbeatAt DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  user            Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  userId    String   @id
  lat       Float
  lng       Float
  accuracy  Float?
  updatedAt DateTime @updatedAt
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id               String                    @id @default(cuid())
  type             String
  name             String?
  joinCode         String?                   @unique
  status           String                    @default("active")
  expirationPolicy String                    @default("24h")
  expiresAt        DateTime?
  createdById      String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  participants     ConversationParticipant[]
  messages         Message[]

  @@index([expiresAt])
  @@index([updatedAt])
  @@index([type, status])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id                    String       @id @default(cuid())
  conversationId        String
  senderId              String
  type                  String       @default("text")
  text                  String?
  fileId                String?
  clientId              String?
  replyToId             String?
  editedAt              DateTime?
  deletedForEveryoneAt  DateTime?
  createdAt             DateTime     @default(now())
  conversation          Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender                Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo               Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies               Message[]    @relation("MessageReplies")
  hiddenFor             MessageHidden[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
}

model MessageHidden {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model Contact {
  id        String   @id @default(cuid())
  ownerId   String
  contactId String
  nickname  String?
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())
  contact   Profile  @relation("ContactTarget", fields: [contactId], references: [id], onDelete: Cascade)
  owner     Profile  @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, contactId])
  @@index([contactId])
}

model Story {
  id        String      @id @default(cuid())
  ownerId   String
  type      String
  text      String?
  fileId    String?
  audience  String      @default("public")
  status    String      @default("active")
  createdAt DateTime    @default(now())
  expiresAt DateTime
  owner     Profile     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  views     StoryView[]

  @@index([ownerId])
  @@index([expiresAt])
  @@index([audience])
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer   Profile  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([viewerId])
}

model Post {
  id           String        @id @default(cuid())
  authorId     String
  text         String
  isAnonymous  Boolean       @default(false)
  voteScore    Int           @default(0)
  commentCount Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  author       Profile       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments     PostComment[]
  votes        PostVote[]

  @@index([createdAt])
  @@index([authorId])
}

model PostVote {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  value     Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  text      String
  isAnonymous Boolean  @default(false)
  createdAt    DateTime @default(now())
  author       Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

model File {
  id          String   @id @default(cuid())
  ownerId     String
  kind        String
  mime        String
  size        Int
  storagePath String
  createdAt   DateTime @default(now())
  owner       Profile  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocked   Profile  @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   Profile  @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model AbuseReport {
  id             String    @id @default(cuid())
  reporterId     String
  reportedUserId String?
  conversationId String?
  reason         String
  details        String?
  status         String    @default("open")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  reportedUser   Profile?  @relation("Reported", fields: [reportedUserId], references: [id])
  reporter       Profile   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reporterId])
  @@index([reportedUserId])
}
