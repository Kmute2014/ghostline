rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /realtimeUsers/{userId}/events/{eventId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /realtimeBroadcasts/{eventId} {
      allow read: if request.auth != null && resource.data.room == 'feed';
      allow write: if false;
    }
  }
}
